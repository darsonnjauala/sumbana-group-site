# Email provider (formulário de contacto). Sem isto, /api/contact responde 200 e logga TODO.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Analytics privacy-first (Plausible). Sem isto, o componente <Analytics/> é no-op.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io

# WhatsApp (E.164 sem +). Override por env quando o número final estiver fechado.
NEXT_PUBLIC_WHATSAPP_NUMBER=
